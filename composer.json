{
  "name": "restruct/silverstripe-featuredimages",
  "description": "Add one or more featured images to any Silverstripe page type, with a configurable maximum",
  "type": "silverstripe-vendormodule",
  "keywords": [
    "silverstripe",
    "silverstripe-module",
    "silverstripe-cms",
    "featured-image",
    "image",
    "page-type"
  ],
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Restruct",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl"
    }
  ],
  "autoload": {
    "psr-4": {
      "Restruct\\SilverStripe\\FeaturedImages\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\FeaturedImages\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "silverstripe/recipe-testing": "^3 || ^4"
  },
  "require": {
    "php": "^8.1",
    "silverstripe/vendor-plugin": "^2 || ^3",
    "silverstripe/cms": "^5 || ^6",
    "bummzack/sortablefile": "^2.2 || ^3"
  },
  "extra": {
    "installer-name": "featuredimages"
  }
}
